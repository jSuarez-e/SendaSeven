# @sdd
# [Objetivo]: Plantilla de variables de entorno para backend NestJS y despliegue en Render.com.
# [I/O]: Define llaves de conexion a base de datos PostgreSQL, puerto y configuracion de entorno.
# [Edge Cases]: Contraseñas seguras y strings de conexion SSL en produccion.

# ==========================================
# 1. SERVIDOR & ENTORNO
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# 2. BASE DE DATOS POSTGRESQL (RENDER.COM)
# ==========================================
# Si utilizas Render PostgreSQL, usa la "Internal Database URL" (si estan en la misma region)
# o la "External Database URL" con el parametro ?sslmode=require
DATABASE_URL=postgresql://sendaseven_user:tu_password_aqui@dpg-xxxxxx-a.oregon-postgres.render.com/sendaseven_db?sslmode=require

# ==========================================
# 3. ALTERNATIVA: PARAMETROS INDIVIDUALES (Si no usas DATABASE_URL)
# ==========================================
DB_HOST=dpg-xxxxxx-a.oregon-postgres.render.com
DB_PORT=5432
DB_USER=sendaseven_user
DB_PASSWORD=tu_password_aqui
DB_NAME=sendaseven_db

# ==========================================
# 4. SINCRONIZACION DEL SCHEMA (TYPEORM)
# ==========================================
# En Render con NODE_ENV=production, debe ser "true" para crear tablas y sembrar el censo oficial
DB_SYNCHRONIZE=true
